# Modelo de variáveis — copie para .env (ignorado pelo Git) ou cadastre na Vercel.
# NÃO preencha valores reais neste arquivo.

# Banco remoto (vazio = SQLite local em data/agende_bem.db).
# Usuário de privilégio mínimo via pooler do Supabase em modo transação, com TLS:
# postgresql://agende_bem_app.<PROJECT_REF>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Segredo compartilhado entre instâncias (assinatura do cookie XSRF).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
STREAMLIT_SERVER_COOKIE_SECRET=

# Opcional: conexões por instância (padrão 3).
DB_POOL_MAX_SIZE=3

# Somente na máquina do operador, para aplicar migrations (nunca na Vercel):
# DATABASE_ADMIN_URL=postgresql://postgres.<PROJECT_REF>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
