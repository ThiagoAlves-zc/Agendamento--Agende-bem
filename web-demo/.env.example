# Modelo de variáveis — copie para .env (ignorado pelo Git) ou cadastre na Vercel.
# NÃO preencha valores reais neste arquivo.

# Banco remoto (vazio = SQLite local em data/agende_bem.db).
# Use uma URL TLS da role de privilégio mínimo fornecida exclusivamente por cofre local.
DATABASE_URL=

# Segredo compartilhado entre instâncias (assinatura do cookie XSRF).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
STREAMLIT_SERVER_COOKIE_SECRET=

# Opcional: conexões por instância (padrão 3).
DB_POOL_MAX_SIZE=3

# Ativação de autenticação e biblioteca V3. Todas as chaves ficam no servidor.
# Em desenvolvimento demonstrativo, mantenha AGENDE_BEM_DEMO_MODE=true e
# AGENDE_BEM_AUTH_REQUIRED=false. Em operação, use false/true respectivamente.
AGENDE_BEM_DEMO_MODE=true
AGENDE_BEM_AUTH_REQUIRED=false
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AGENDE_BEM_AUTH_REDIRECT_URL=http://localhost:8501
# Uso único durante o bootstrap seguro do primeiro administrador; deixe vazio
# fora desse procedimento e nunca versione um valor real.
AGENDE_BEM_BOOTSTRAP_TOKEN=

# Somente na máquina do operador, para aplicar migrations (nunca na Vercel):
# DATABASE_ADMIN_URL=  # forneça o valor por cofre local ou variável de sessão
